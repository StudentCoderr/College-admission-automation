# ===========================================================================
# College Admission Automation System - Environment Variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ===========================================================================

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# ---------------------------------------------------------------------------
# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for browser use, but this backend does NOT use it)
SUPABASE_ANON_KEY=your-anon-public-key

# SERVICE ROLE key - full database access. SERVER SIDE ONLY.
# NEVER expose this value in frontend JavaScript or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private storage bucket that holds uploaded admission documents
SUPABASE_STORAGE_BUCKET=admission-documents

# ---------------------------------------------------------------------------
# Offline / local database (optional)
# ---------------------------------------------------------------------------
# Set USE_LOCAL_DB=true to run the whole app from a persistent JSON database
# and local uploads folder. No Supabase project, internet connection or Docker
# is required. Register/login, courses, applications and document uploads work
# and survive restarts. Set it back to false after configuring Supabase.
#
# The defaults are instance/local_db.json and instance/uploads. You can
# override them if needed. Local mode assumes ONE app process: do not enable the
# Flask reloader or run multiple Gunicorn workers against the same file.
USE_LOCAL_DB=false
# LOCAL_DB_PATH=instance/local_db.json
# LOCAL_UPLOADS_DIR=instance/uploads

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
FLASK_ENV=development
# Max upload size in bytes (5 MB)
MAX_CONTENT_LENGTH=5242880
# Signed document URL lifetime in seconds (5 minutes)
SIGNED_URL_EXPIRES_IN=300

# ---------------------------------------------------------------------------
# Initial administrator account (provisioned with `flask --app wsgi create-admin`).
# To wipe an existing database and set a new administrator, use
# `flask --app wsgi reset-project` (it needs no old password).
# Placeholders only - copy these into your real .env and fill them in. The
# command falls back to interactive (hidden) prompts for anything left blank,
# so ADMIN_PASSWORD is optional here.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.edu.in
ADMIN_FULL_NAME=System Administrator
# Initial password for the administrator. It is read from the environment,
# NEVER printed, written into source code, or stored in logs. It is hashed
# (Werkzeug scrypt) before it is saved to the users table. After the account
# has been created, remove this line from .env and keep it somewhere safe.
ADMIN_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# JSON REST API (/api)
# ---------------------------------------------------------------------------
# Require an X-CSRF-Token header on state-changing API requests (recommended).
API_CSRF_ENABLED=true
# Browser origins allowed to call the API with credentials (comma separated).
# 8080 = static frontend, 8081 = static admin console (stand-alone mode),
# 5000 = local Flask dev server (same origin, harmless to include).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5000,http://127.0.0.1:5000
